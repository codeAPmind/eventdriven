# 事件驱动系统定时任务
# 安装: crontab -l 2>/dev/null | cat - crontab.example | crontab -

# 工作日 17:20 抓取龙虎榜、识别席位、推送飞书日报
20 17 * * 1-5 /Users/openclaw/openclaw_workspace/EventDriven/eventdriven_run.sh

# 每周日 20:00 运行回测验证（可选）
0 20 * * 0 cd /Users/openclaw/openclaw_workspace/EventDriven/event_system && /Users/openclaw/miniforge3/bin/conda run -n eventdriven python backtest.py >> /Users/openclaw/openclaw_workspace/eventdriven_runtime/backtest.log 2>&1
